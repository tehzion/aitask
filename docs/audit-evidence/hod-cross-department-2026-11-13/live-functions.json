    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_can_edit_task(p_workspace_id text, p_task_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select coalesce((\n    select private.aitask_is_super_admin(p_workspace_id)\n      or (private.aitask_member_role(p_workspace_id) in ('Project Manager','Staff')\n        and task.assigned_to = private.aitask_member_id(p_workspace_id))\n      or (\n        private.aitask_member_role(p_workspace_id) in ('Project Manager', 'Staff')\n        and (\n          task.assigned_to = private.aitask_member_id(p_workspace_id)\n          or (nullif(btrim(task.assigned_to), '') is null and task.data -\u003e\u003e 'assignedBy' = private.aitask_member_id(p_workspace_id))\n          or task.created_by = private.aitask_member_id(p_workspace_id)\n        )\n        and (\n          private.aitask_member_role(p_workspace_id) \u003c\u003e 'Project Manager'\n          or nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is null\n          or private.aitask_can_view_project(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n        )\n        and (\n          not private.aitask_is_hod(p_workspace_id)\n          or nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is null\n          or private.aitask_hod_is_assigned(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n        )\n      )\n      or (\n        private.aitask_member_role(p_workspace_id) = 'Project Manager'\n        and nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is null\n        and exists (\n          select 1 from public.aitask_entities client\n          where client.workspace_id = p_workspace_id\n            and client.entity_type = 'client'\n            and client.client_key = task.client_key\n            and client.created_by = private.aitask_member_id(p_workspace_id)\n        )\n      )\n      or (\n        private.aitask_member_role(p_workspace_id) = 'Project Manager'\n        and nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is not null\n        and private.aitask_can_view_project(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n      )\n      or (\n        private.aitask_role_is_department_scoped(p_workspace_id)\n        and private.aitask_task_department(task.data -\u003e\u003e 'department') = any(coalesce((\n          select member.departments\n          from public.aitask_members member\n          where member.workspace_id = p_workspace_id\n            and member.auth_user_id = (select auth.uid())\n        ), array[]::text[]))\n        and (\n          not private.aitask_is_hod(p_workspace_id)\n          or nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is null\n          or private.aitask_hod_is_assigned(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n        )\n      )\n    from public.aitask_entities task\n    where task.workspace_id = p_workspace_id\n      and task.entity_type = 'task'\n      and task.entity_id = p_task_id\n    limit 1\n  ), false);\n$function$\n",
      "nspname": "private",
      "proname": "aitask_can_edit_task"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_can_mutate_entity(p_workspace_id text, p_action text, p_entity_type text, p_entity_id text, p_parent_id text, p_old_data jsonb, p_new_data jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  v_member_id text := private.aitask_member_id(p_workspace_id);\n  v_role text := private.aitask_member_role(p_workspace_id);\n  v_project_id text := nullif(btrim(coalesce(p_new_data -\u003e\u003e 'projectId', p_parent_id, '')), '');\n  v_client_key text := lower(btrim(coalesce(p_new_data -\u003e\u003e 'clientName', p_old_data -\u003e\u003e 'clientName', '')));\nbegin\n  if p_action = 'insert' and p_entity_type = 'task' and v_role = 'Project Manager'\n    and not private.aitask_is_super_admin(p_workspace_id) then\n    if coalesce(p_new_data -\u003e\u003e 'createdBy', p_new_data -\u003e\u003e 'userId', '') \u003c\u003e v_member_id then\n      return false;\n    end if;\n    if not private.aitask_task_project_link_is_valid(\n      p_workspace_id,\n      v_project_id,\n      nullif(btrim(coalesce(p_new_data -\u003e\u003e 'clientId', '')), ''),\n      v_client_key\n    ) or not private.aitask_task_assignment_is_valid(p_workspace_id, p_action, p_old_data, p_new_data) then\n      return false;\n    end if;\n    if v_project_id is not null then\n      return private.aitask_project_manager_id_is_assigned(p_workspace_id, v_project_id, v_member_id);\n    end if;\n    return exists (\n      select 1 from public.aitask_entities client\n      where client.workspace_id = p_workspace_id\n        and client.entity_type = 'client'\n        and client.client_key = v_client_key\n        and client.created_by = v_member_id\n    );\n  end if;\n  -- HODs are represented as Staff by the historical member-role projection.\n  -- Handle an explicit route handoff before the legacy edit gate so an HOD\n  -- who currently owns the task can delegate it without gaining broad Staff\n  -- mutation authority.\n  if p_action = 'update' and p_entity_type = 'task'\n    and private.aitask_is_hod(p_workspace_id)\n    and (p_old_data -\u003e\u003e 'assignedTo' = v_member_id or p_old_data -\u003e\u003e 'responsibleHodId' = v_member_id)\n    and (\n      p_old_data -\u003e\u003e 'assignedTo' is distinct from p_new_data -\u003e\u003e 'assignedTo'\n      or p_old_data -\u003e\u003e 'responsibleHodId' is distinct from p_new_data -\u003e\u003e 'responsibleHodId'\n      or p_old_data -\u003e\u003e 'assignmentState' is distinct from p_new_data -\u003e\u003e 'assignmentState'\n    ) then\n    return private.aitask_task_assignment_is_valid(p_workspace_id, p_action, p_old_data, p_new_data);\n  end if;\n  if p_action = 'update' and p_entity_type = 'task'\n    and private.aitask_is_hod(p_workspace_id) then\n    if not private.aitask_hod_task_execution_patch_is_valid(p_workspace_id, p_old_data, p_new_data) then\n      return false;\n    end if;\n    if (\n      p_old_data -\u003e\u003e 'assignedTo' is distinct from p_new_data -\u003e\u003e 'assignedTo'\n      or p_old_data -\u003e\u003e 'responsibleHodId' is distinct from p_new_data -\u003e\u003e 'responsibleHodId'\n      or p_old_data -\u003e\u003e 'assignmentState' is distinct from p_new_data -\u003e\u003e 'assignmentState'\n    ) then\n      return private.aitask_task_assignment_is_valid(p_workspace_id, p_action, p_old_data, p_new_data);\n    end if;\n  end if;\n  return private.aitask_can_mutate_entity_legacy(\n    p_workspace_id, p_action, p_entity_type, p_entity_id, p_parent_id, p_old_data, p_new_data\n  );\nend;\n$function$\n",
      "nspname": "private",
      "proname": "aitask_can_mutate_entity"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_can_view_task(p_workspace_id text, p_task_id text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select coalesce((\n    select case\n      when private.aitask_is_super_admin(p_workspace_id) then true\n      when private.aitask_member_role(p_workspace_id) in ('Project Manager','Staff')\n        and task.assigned_to = private.aitask_member_id(p_workspace_id) then true\n      when private.aitask_member_role(p_workspace_id) = 'Project Manager' then\n        case\n          when nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is not null\n            then private.aitask_can_view_project(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n          else task.assigned_to = private.aitask_member_id(p_workspace_id)\n            or (nullif(btrim(task.assigned_to), '') is null and task.data -\u003e\u003e 'assignedBy' = private.aitask_member_id(p_workspace_id))\n            or task.created_by = private.aitask_member_id(p_workspace_id)\n            or exists (\n              select 1 from public.aitask_entities client\n              where client.workspace_id = p_workspace_id\n                and client.entity_type = 'client'\n                and client.client_key = task.client_key\n                and client.created_by = private.aitask_member_id(p_workspace_id)\n            )\n        end\n      when private.aitask_member_role(p_workspace_id) = 'Staff' then\n        (\n          (\n            (not private.aitask_is_hod(p_workspace_id)\n              and private.aitask_has_permission(p_workspace_id, 'viewAllTasks'))\n            or task.assigned_to = private.aitask_member_id(p_workspace_id)\n            or task.created_by = private.aitask_member_id(p_workspace_id)\n            or (\n              private.aitask_role_is_department_scoped(p_workspace_id)\n              and private.aitask_task_department(task.data -\u003e\u003e 'department') = any(coalesce((\n                select member.departments\n                from public.aitask_members member\n                where member.workspace_id = p_workspace_id\n                  and member.auth_user_id = (select auth.uid())\n              ), array[]::text[]))\n            )\n          )\n          and (\n            not private.aitask_is_hod(p_workspace_id)\n            or nullif(btrim(coalesce(task.data -\u003e\u003e 'projectId', task.parent_id, '')), '') is null\n            or private.aitask_hod_is_assigned(p_workspace_id, coalesce(task.data -\u003e\u003e 'projectId', task.parent_id))\n          )\n        )\n      when private.aitask_member_role(p_workspace_id) = 'Client' then\n        task.client_key = private.aitask_member_client_key(p_workspace_id)\n      else false\n    end\n    from public.aitask_entities task\n    where task.workspace_id = p_workspace_id\n      and task.entity_type = 'task'\n      and task.entity_id = p_task_id\n    limit 1\n  ), false);\n$function$\n",
      "nspname": "private",
      "proname": "aitask_can_view_task"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_guard_entity()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  forbidden_key text;\n  v_actor_member_id text;\nbegin\n  select key into forbidden_key\n  from jsonb_object_keys(new.data) key\n  where key ~* '(password|secret|token|api[_-]?key|service[_-]?role)'\n  limit 1;\n  if forbidden_key is not null then\n    raise exception 'AiTask entities cannot contain secret-like fields';\n  end if;\n\n  if tg_op = 'UPDATE'\n    and old.entity_type = 'client'\n    and lower(trim(coalesce(old.data -\u003e\u003e 'clientName', '')))\n      is distinct from lower(trim(coalesce(new.data -\u003e\u003e 'clientName', '')))\n    and not private.aitask_is_admin(old.workspace_id) then\n    raise exception 'Only Project Managers can rename clients';\n  end if;\n\n  -- Record who assigned a task, from the authenticated actor. Reassignment\n  -- (assignedTo changed) and creation both update the attribution; any other\n  -- task edit keeps the previous assigner untouched.\n  if new.entity_type = 'task'\n    and (\n      tg_op = 'INSERT'\n      or (tg_op = 'UPDATE'\n        and coalesce(old.data -\u003e\u003e 'assignedTo', '') is distinct from coalesce(new.data -\u003e\u003e 'assignedTo', ''))\n    ) then\n    v_actor_member_id := private.aitask_member_id(new.workspace_id);\n    if v_actor_member_id is not null then\n      new.data := jsonb_set(coalesce(new.data, '{}'::jsonb), '{assignedBy}', to_jsonb(v_actor_member_id), true);\n      new.data := jsonb_set(\n        new.data,\n        '{assignedAt}',\n        to_jsonb(to_char(now() at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"')),\n        true\n      );\n    end if;\n  end if;\n\n  -- A task edit that does not change the assignee keeps the stored attribution\n  -- exactly, even if the payload tried to supply a different one.\n  if new.entity_type = 'task'\n    and tg_op = 'UPDATE'\n    and coalesce(old.data -\u003e\u003e 'assignedTo', '') = coalesce(new.data -\u003e\u003e 'assignedTo', '') then\n    new.data := new.data - 'assignedBy' - 'assignedAt';\n    if old.data ? 'assignedBy' then\n      new.data := jsonb_set(new.data, '{assignedBy}', old.data -\u003e 'assignedBy', true);\n    end if;\n    if old.data ? 'assignedAt' then\n      new.data := jsonb_set(new.data, '{assignedAt}', old.data -\u003e 'assignedAt', true);\n    end if;\n  end if;\n\n  new.client_key := lower(trim(coalesce(new.data -\u003e\u003e 'clientName', new.data -\u003e\u003e 'targetClient', '')));\n  new.assigned_to := nullif(trim(new.data -\u003e\u003e 'assignedTo'), '');\n  new.created_by := nullif(trim(coalesce(new.data -\u003e\u003e 'createdBy', new.data -\u003e\u003e 'userId')), '');\n  new.target_user_id := nullif(trim(new.data -\u003e\u003e 'targetUserId'), '');\n  new.target_role := nullif(trim(new.data -\u003e\u003e 'targetRole'), '');\n  new.target_client_key := lower(trim(coalesce(new.data -\u003e\u003e 'targetClient', '')));\n  new.parent_id := case\n    when new.entity_type = 'task' then nullif(trim(new.data -\u003e\u003e 'projectId'), '')\n    when new.entity_type in ('comment', 'approval') then nullif(trim(new.data -\u003e\u003e 'taskId'), '')\n    else new.parent_id\n  end;\n  new.updated_at := now();\n  return new;\nend;\n$function$\n",
      "nspname": "private",
      "proname": "aitask_guard_entity"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_hod_task_execution_patch_is_valid(p_workspace_id text, p_old_data jsonb, p_new_data jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  v_field text;\n  v_route_changed boolean := (\n    p_old_data -\u003e\u003e 'assignedTo' is distinct from p_new_data -\u003e\u003e 'assignedTo'\n    or p_old_data -\u003e\u003e 'responsibleHodId' is distinct from p_new_data -\u003e\u003e 'responsibleHodId'\n    or p_old_data -\u003e\u003e 'assignmentState' is distinct from p_new_data -\u003e\u003e 'assignmentState'\n  );\n  v_restricted_fields text[] := array[\n    'projectId', 'projectName', 'clientId', 'clientName', 'serviceType',\n    'serviceCycleId', 'deliverableId', 'milestoneId', 'department',\n    'visibility', 'customerDetails', 'facebookPage', 'website',\n    'isRecurring', 'recurrenceFrequency', 'assignedBy', 'assignedAt',\n    'responsibleHodId', 'assignmentState', 'assignmentOverride',\n    'reviewEvidence', 'reviewAccess', 'reviewDecision', 'reviewCover',\n    'accountableLeadId', 'requiresInternalApproval', 'approvalMode',\n    'outputAttachments', 'workflowStepKind', 'workflowStepId',\n    'workflowStepOrder', 'workflowStepRequired', 'workflowTemplateId',\n    'workflowTemplateRevision', 'generatedFromDeliverable',\n    'predecessorTaskIds', 'workflowOutputVersion',\n    'workflowDependenciesReady', 'internalReview', 'reviewOverrideReason'\n  ];\nbegin\n  if not private.aitask_is_hod(p_workspace_id) then return true; end if;\n  -- The assigned HOD does the work, so they may attach its output files.\n  if p_old_data -\u003e\u003e 'assignedTo' = private.aitask_member_id(p_workspace_id)\n    and p_new_data -\u003e\u003e 'assignedTo' = p_old_data -\u003e\u003e 'assignedTo' then\n    v_restricted_fields := array_remove(v_restricted_fields, 'outputAttachments');\n  end if;\n  -- Assignment metadata is server-shaped by the client store, then checked by\n  -- aitask_task_assignment_is_valid below. It may change only in the same\n  -- patch as a real route transition; a metadata-only forgery remains denied.\n  if not v_route_changed then\n    foreach v_field in array v_restricted_fields loop\n      if private.aitask_restricted_task_field_changed(v_field, p_old_data -\u003e v_field, p_new_data -\u003e v_field) then\n        return false;\n      end if;\n    end loop;\n  else\n    foreach v_field in array v_restricted_fields loop\n      if v_field not in ('assignedBy', 'responsibleHodId', 'assignmentState')\n        and private.aitask_restricted_task_field_changed(v_field, p_old_data -\u003e v_field, p_new_data -\u003e v_field) then\n        return false;\n      end if;\n    end loop;\n    -- Assignment attribution is not client-authored metadata. The entity\n    -- trigger stamps it when assignedTo changes; route-only edits must keep\n    -- the stored timestamp and may name only the authenticated HOD as actor.\n    if private.aitask_restricted_task_field_changed('assignedAt', p_old_data -\u003e 'assignedAt', p_new_data -\u003e 'assignedAt')\n      or p_new_data -\u003e\u003e 'assignedBy' is distinct from private.aitask_member_id(p_workspace_id) then\n      return false;\n    end if;\n  end if;\n  return true;\nend;\n$function$\n",
      "nspname": "private",
      "proname": "aitask_hod_task_execution_patch_is_valid"
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION private.aitask_task_assignment_is_valid(p_workspace_id text, p_action text, p_old_data jsonb, p_new_data jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  v_old_assignee text := coalesce(p_old_data -\u003e\u003e 'assignedTo', '');\n  v_new_assignee text := coalesce(p_new_data -\u003e\u003e 'assignedTo', '');\n  v_old_department text := private.aitask_task_department(p_old_data -\u003e\u003e 'department');\n  v_new_department text := private.aitask_task_department(p_new_data -\u003e\u003e 'department');\n  v_old_creator text := coalesce(p_old_data -\u003e\u003e 'createdBy', p_old_data -\u003e\u003e 'userId', '');\n  v_new_creator text := coalesce(p_new_data -\u003e\u003e 'createdBy', p_new_data -\u003e\u003e 'userId', '');\n  v_old_hod text := coalesce(p_old_data -\u003e\u003e 'responsibleHodId', '');\n  v_new_hod text := coalesce(p_new_data -\u003e\u003e 'responsibleHodId', '');\n  v_old_state text := coalesce(p_old_data -\u003e\u003e 'assignmentState', '');\n  v_new_state text := coalesce(p_new_data -\u003e\u003e 'assignmentState', '');\n  v_project_id text := nullif(btrim(coalesce(p_new_data -\u003e\u003e 'projectId', p_old_data -\u003e\u003e 'projectId', '')), '');\n  v_actor_member_id text := private.aitask_member_id(p_workspace_id);\n  v_actor_role text := private.aitask_member_role(p_workspace_id);\n  v_actor_is_hod boolean := exists (\n    select 1 from public.aitask_members actor\n    where actor.workspace_id = p_workspace_id\n      and actor.id = v_actor_member_id\n      and (actor.role = 'HOD' or actor.custom_role_id = 'builtin-hod')\n  );\n  v_override_reason text := btrim(coalesce(p_new_data -\u003e 'assignmentOverride' -\u003e\u003e 'reason', ''));\n  v_override_actor text := coalesce(p_new_data -\u003e 'assignmentOverride' -\u003e\u003e 'actorId', '');\n  v_project_hod_membership_defined boolean := false;\n  v_project_staff_membership_defined boolean := false;\n  v_department_has_hod boolean := false;\nbegin\n  -- Client approval commands use a privacy projection and never mutate the\n  -- assignment route. Their existing validator remains authoritative.\n  if p_action = 'update' and v_actor_role = 'Client'\n    and current_setting('aitask.command_type', true) = 'approval.review'\n    and current_setting('aitask.client_command_allowed', true) = 'true' then\n    return true;\n  end if;\n\n  if p_action = 'update' and v_old_creator is distinct from v_new_creator then\n    return false;\n  end if;\n  if v_new_department is null then return false; end if;\n\n  if v_project_id is not null then\n    select coalesce(project.data ? 'hodMemberIds', false), coalesce(project.data ? 'staffMemberIds', false)\n      into v_project_hod_membership_defined, v_project_staff_membership_defined\n    from public.aitask_entities project\n    where project.workspace_id = p_workspace_id\n      and project.entity_type = 'project'\n      and project.entity_id = v_project_id;\n  end if;\n\n  -- HOD-first routing applies only where the task department has an active\n  -- HOD. Departments without one keep the Project Manager fallback: the PM\n  -- assigns Staff directly and no responsible HOD is recorded.\n  v_department_has_hod := exists (\n    select 1\n    from public.aitask_members hod\n    join auth.users auth_user on auth_user.id = hod.auth_user_id\n    where hod.workspace_id = p_workspace_id\n      and (hod.role = 'HOD' or hod.custom_role_id = 'builtin-hod')\n      and v_new_department = any(coalesce(hod.departments, array[]::text[]))\n      and (auth_user.banned_until is null or auth_user.banned_until \u003c= now())\n  );\n\n  -- A complete non-assignment edit must preserve all route fields. This keeps\n  -- the fast path while preventing clients from changing state invisibly.\n  if p_action = 'update'\n    and v_old_assignee = v_new_assignee\n    and v_old_department is not distinct from v_new_department\n    and v_old_hod = v_new_hod\n    and v_old_state = v_new_state\n    and p_old_data -\u003e 'assignmentOverride' is not distinct from p_new_data -\u003e 'assignmentOverride' then\n    return true;\n  end if;\n\n\n  if v_actor_role = 'Project Manager' then\n    if v_project_id is not null and not private.aitask_is_super_admin(p_workspace_id)\n      and not private.aitask_project_manager_id_is_assigned(p_workspace_id,v_project_id,v_actor_member_id) then\n      return false;\n    end if;\n    -- The caller's outer mutation guard enforces project/company ownership.\n    -- Preserve route consistency without requiring a department HOD.\n    if v_new_state not in ('', 'needs_hod', 'pending_hod', 'assigned_staff') then return false; end if;\n    if v_new_state = 'needs_hod' and (v_new_assignee \u003c\u003e '' or v_new_hod \u003c\u003e '') then return false; end if;\n    if v_new_state = 'pending_hod' and (v_new_hod = '' or v_new_assignee \u003c\u003e v_new_hod) then return false; end if;\n    if v_override_reason \u003c\u003e '' and v_override_actor \u003c\u003e v_actor_member_id then return false; end if;\n    if v_new_hod \u003c\u003e '' and not exists (\n      select 1 from public.aitask_members hod\n      join auth.users account on account.id=hod.auth_user_id\n      where hod.workspace_id=p_workspace_id and hod.id=v_new_hod\n        and (hod.role='HOD' or hod.custom_role_id='builtin-hod')\n        and (account.banned_until is null or account.banned_until \u003c= now())\n    ) then return false; end if;\n    if v_new_assignee = '' then return true; end if;\n    return exists (\n      select 1 from public.aitask_members member\n      join auth.users account on account.id=member.auth_user_id\n      where member.workspace_id=p_workspace_id and member.id=v_new_assignee\n        and member.role \u003c\u003e 'Client'\n        and (account.banned_until is null or account.banned_until \u003c= now())\n    );\n  end if;\n\n  -- A newly-created PM task must have a valid HOD handoff. The existing\n  -- Waiting Approval insertion path remains available for explicit review\n  -- tasks, which are not normal production assignments.\n  if p_action = 'insert'\n    and v_actor_role = 'Project Manager'\n    and not private.aitask_is_super_admin(p_workspace_id)\n    and coalesce(p_new_data -\u003e\u003e 'status', '') \u003c\u003e 'Waiting Approval'\n    and v_department_has_hod then\n    if v_new_state \u003c\u003e 'pending_hod' or v_new_hod = '' or v_new_assignee \u003c\u003e v_new_hod then\n      return false;\n    end if;\n  end if;\n\n  -- Route-state consistency is enforced for new records and any record that\n  -- opts into the explicit state fields. Omitted fields remain legacy-safe.\n  if v_new_state \u003c\u003e '' and v_new_state not in ('needs_hod', 'pending_hod', 'assigned_staff') then\n    return false;\n  end if;\n  if v_new_state = 'needs_hod' and (v_new_assignee \u003c\u003e '' or v_new_hod \u003c\u003e '') then\n    return false;\n  end if;\n  if v_new_state = 'pending_hod' and (v_new_hod = '' or v_new_assignee \u003c\u003e v_new_hod) then\n    return false;\n  end if;\n  if v_new_state = 'assigned_staff' and v_new_hod = '' and v_department_has_hod then\n    return false;\n  end if;\n\n  -- Any supplied responsible HOD must be an active HOD in the task\n  -- department and, where configured, an explicit member of the project.\n  if v_new_hod \u003c\u003e '' and not exists (\n    select 1\n    from public.aitask_members hod\n    join auth.users auth_user on auth_user.id = hod.auth_user_id\n    where hod.workspace_id = p_workspace_id\n      and hod.id = v_new_hod\n      and (hod.role = 'HOD' or hod.custom_role_id = 'builtin-hod')\n      and v_new_department = any(coalesce(hod.departments, array[]::text[]))\n      and (auth_user.banned_until is null or auth_user.banned_until \u003c= now())\n      and (\n        v_project_id is null\n        or not v_project_hod_membership_defined\n        or exists (\n          select 1 from public.aitask_entities project\n          where project.workspace_id = p_workspace_id\n            and project.entity_type = 'project'\n            and project.entity_id = v_project_id\n            and project.data -\u003e 'hodMemberIds' ? v_new_hod\n        )\n      )\n  ) then\n    return false;\n  end if;\n\n  -- Preserve the existing mutation boundary. Boss Koo keeps workspace-wide\n  -- authority; PMs and department leads must operate inside their scope.\n  if p_action = 'update'\n    and not private.aitask_is_super_admin(p_workspace_id)\n    and not (\n      v_old_creator = v_actor_member_id\n      and private.aitask_has_permission(p_workspace_id, 'manageCreatedTasks')\n    )\n    and not (\n      v_actor_is_hod\n      and private.aitask_has_permission(p_workspace_id, 'manageCreatedTasks')\n      and (v_old_assignee = v_actor_member_id or v_old_hod = v_actor_member_id\n        -- Older tasks record no responsible HOD; the department HOD on the\n        -- task's project leads them.\n        or (v_old_hod = ''\n          and v_old_department = any(coalesce((\n            select member.departments from public.aitask_members member\n            where member.workspace_id = p_workspace_id and member.id = v_actor_member_id\n          ), array[]::text[]))\n          and (v_project_id is null or private.aitask_hod_is_assigned(p_workspace_id, v_project_id))))\n    )\n    and not (\n      v_actor_role = 'Project Manager'\n      and (\n        (v_project_id is not null and private.aitask_project_manager_id_is_assigned(p_workspace_id, v_project_id, v_actor_member_id))\n        or v_old_assignee = v_actor_member_id\n        or v_old_creator = v_actor_member_id\n        or exists (\n          select 1 from public.aitask_entities client\n          where client.workspace_id = p_workspace_id\n            and client.entity_type = 'client'\n            and client.client_key = lower(btrim(coalesce(p_old_data -\u003e\u003e 'clientName', p_new_data -\u003e\u003e 'clientName', '')))\n            and client.created_by = v_actor_member_id\n        )\n      )\n    ) then\n    return false;\n  end if;\n\n  -- HODs may hand pending work to project-authorized Staff only. Staff cannot\n  -- self-assign or mutate a route state, even when they share a project.\n  if p_action = 'update' and v_actor_is_hod and v_new_assignee \u003c\u003e v_old_assignee then\n    if v_old_hod \u003c\u003e v_actor_member_id\n      and v_old_assignee \u003c\u003e v_actor_member_id\n      and not (\n        v_actor_is_hod\n        and v_old_department = any(coalesce((\n          select member.departments\n          from public.aitask_members member\n          where member.workspace_id = p_workspace_id\n            and member.id = v_actor_member_id\n        ), array[]::text[]))\n        and (v_project_id is null or private.aitask_hod_is_assigned(p_workspace_id, v_project_id))\n      ) then\n      return false;\n    end if;\n  end if;\n  if p_action = 'update' and v_actor_role = 'Staff' and not v_actor_is_hod\n    and (v_new_assignee \u003c\u003e v_old_assignee or v_new_hod \u003c\u003e v_old_hod or v_new_state \u003c\u003e v_old_state) then\n    return false;\n  end if;\n\n  -- Where the department has an HOD, a PM may bypass the HOD stage only\n  -- through an explicit, reasoned override. Moving a Staff-assigned task into\n  -- such a department counts as a bypass too. A task created directly in\n  -- review is the PM handing finished work to its reviewer, as on insert above.\n  if v_new_assignee \u003c\u003e ''\n    and (v_new_assignee \u003c\u003e v_old_assignee or v_new_department is distinct from v_old_department)\n    and v_department_has_hod\n    and not (p_action = 'insert' and coalesce(p_new_data -\u003e\u003e 'status', '') = 'Waiting Approval')\n    and v_actor_role = 'Project Manager'\n    and not private.aitask_is_super_admin(p_workspace_id)\n    and exists (\n      select 1 from public.aitask_members target\n      where target.workspace_id = p_workspace_id\n        and target.id = v_new_assignee\n        and target.role = 'Staff'\n        and coalesce(target.custom_role_id, '') \u003c\u003e 'builtin-hod'\n    )\n    and v_override_reason = '' then\n    return false;\n  end if;\n  if v_override_reason \u003c\u003e '' and (v_actor_role \u003c\u003e 'Project Manager' or v_override_actor \u003c\u003e v_actor_member_id) then\n    return false;\n  end if;\n\n  if v_new_assignee \u003c\u003e '' and not exists (\n    select 1\n    from public.aitask_members member\n    join auth.users auth_user on auth_user.id = member.auth_user_id\n    where member.workspace_id = p_workspace_id\n      and member.id = v_new_assignee\n      and member.role \u003c\u003e 'Client'\n      and (auth_user.banned_until is null or auth_user.banned_until \u003c= now())\n      and (member.role = 'Project Manager' or v_new_department = any(coalesce(member.departments, array[]::text[])))\n      and (\n        member.role \u003c\u003e 'Staff'\n        or not v_project_staff_membership_defined\n        or v_actor_is_hod\n        or v_new_state \u003c\u003e 'assigned_staff'\n        or exists (\n          select 1 from public.aitask_entities project\n          where project.workspace_id = p_workspace_id\n            and project.entity_type = 'project'\n            and project.entity_id = v_project_id\n            and project.data -\u003e 'staffMemberIds' ? v_new_assignee\n        )\n      )\n  ) then\n    return false;\n  end if;\n\n  return true;\nend;\n$function$\n",
